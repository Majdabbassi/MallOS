{
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/mall-os",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://mallos-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://mallos-api.onrender.com/auth/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
