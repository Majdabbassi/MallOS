# Database
DB_NAME=mallos
DB_PASSWORD=change-me


# Bootstrap SUPER_ADMIN account (created only when the DB is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Demo data (seeded only when the DB has no malls yet)
DEMO_ENABLED=true
DEMO_MANAGER_USERNAME=manager
DEMO_MANAGER_EMAIL=manager@mallos.local
DEMO_MANAGER_PASSWORD=Manager@123

# Port exposed for the frontend (nginx)
FRONTEND_PORT=80

# Port exposed for the backend API
BACKEND_PORT=8080

# JWT signing key (at least 32 characters). Generate a real one for any public deployment: openssl rand -hex 32
# The "dev-only" default below is refused when SPRING_PROFILES_ACTIVE=prod.
JWT_SECRET=dev-only-change-me-signing-key-32-bytes-minimum
JWT_EXPIRATION_MS=86400000